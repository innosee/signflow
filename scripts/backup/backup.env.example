# Signflow Off-Site-Backup — Konfiguration
# =========================================
# Kopieren nach `backup.env` und ausfüllen. NIEMALS committen (steht in
# .gitignore). Auf der VM: chmod 600 backup.env  (enthält DB- + R2-Secrets).

# --- Neon Postgres -----------------------------------------------------------
# Prod-Connection-String (NICHT die .env.local-Variante). sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Cloudflare R2 -----------------------------------------------------------
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="..."
# eu  -> <account>.eu.r2.cloudflarestorage.com (Default, unser EU-Bucket)
# default -> <account>.r2.cloudflarestorage.com
R2_JURISDICTION="eu"

# --- Verschlüsselung (asymmetrisch) ------------------------------------------
# Key-ID oder E-Mail des Backup-PUBLIC-Keys. Nur der Public Key liegt auf der
# VM; der Private Key wird OFFLINE verwahrt (z.B. im Passwort-Manager / Tresor).
# Erzeugen siehe README ("Schlüssel einrichten").
GPG_RECIPIENT="backup@innosee.de"

# --- Ziel & Retention --------------------------------------------------------
BACKUP_ROOT="/var/backups/signflow"
RETENTION_DAYS="90"   # DB-Dumps älter als N Tage löschen ...
MIN_KEEP="7"          # ... aber immer mind. die letzten N behalten

# --- Optional: Fehler-Benachrichtigung ---------------------------------------
# Slack/Teams-Webhook; wird nur bei FEHLERN angepingt. Leer = aus.
BACKUP_WEBHOOK_URL=""
